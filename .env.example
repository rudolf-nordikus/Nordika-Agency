# Postavlja se u Vercel -> Settings -> Environment Variables.
# Lokalno (za `vercel dev`) kopiraj u .env.local.

# Resend ključ. Mora imati pravo slanja; restriktivni "sending only" ključ
# radi za slanje, ali ne može dodati ni verifikovati domen.
RESEND_API_KEY=

# Ko prima prijave. Više adresa se razdvaja zarezom.
KONTAKT_EMAIL_ZA=info@nordika-agency.com

# Pošiljalac. Domen mora biti verifikovan u Resendu.
KONTAKT_EMAIL_OD=Nordika Agency <kontakt@nordika-agency.com>
